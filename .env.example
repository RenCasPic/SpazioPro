# SpazioPro — copy to .env.local. Runs fully in DEMO mode with none of these set:
# data lives in the browser and AI responses are simulated locally.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Demo mode ----
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ---- AI provider ----
# "demo" needs no key or network. Register a real provider in lib/ai/provider.ts.
AI_PROVIDER=demo
NEXT_PUBLIC_AI_PROVIDER=demo
AI_API_KEY=

# ---- Supabase (optional backend) ----
# Provide all three, apply supabase/migrations + supabase/seed.sql, then set
# DEMO_MODE=false to move persistence + auth server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
