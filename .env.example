# --- AI providers -------------------------------------------------------------
# The app ships with a fully offline DEMO provider. Leave this unset to use it.
# Set to a registered provider id (see src/services/ai/index.ts) to go live.
NEXT_PUBLIC_AI_PROVIDER=demo
AI_API_KEY=

# --- Supabase (optional) -----------------------------------------------------
# Persistence currently uses localStorage (see src/services/projectService.ts).
# Provide these and implement the Supabase ProjectRepository to enable the backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
